{
  "manifest_version": 3,
  "name": "네오앤피터 AI 블로그 도우미 · 수강생용",
  "version": "2.7.1",
  "description": "같은 Chrome 프로필에서 직접 전달한 블로그 초안을 확인하고 에디터에 옮기는 수강생용 도구.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs",
    "clipboardRead",
    "clipboardWrite",
    "sidePanel"
  ],
  "side_panel": {
    "default_path": "popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "host_permissions": [
    "https://aiedu1.vercel.app/*",
    "https://www.neonpeter.com/*",
    "https://neonpeter.com/*",
    "https://blog.naver.com/*",
    "https://*.blog.naver.com/*",
    "https://blog.editor.naver.com/*",
    "https://*.tistory.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://aiedu1.vercel.app/*",
        "https://www.neonpeter.com/*",
        "https://neonpeter.com/*",
        "https://blog.naver.com/*",
        "https://*.blog.naver.com/*",
        "https://blog.editor.naver.com/*",
        "https://*.tistory.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_end",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "네오앤피터 AI 블로그 자동 포스팅",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}